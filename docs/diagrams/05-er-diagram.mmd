erDiagram
    %% ── Auth Domain ──
    users {
        int id PK
        string username UK
        string email UK
        string hashed_password
        string full_name
        int role_id FK
        bool is_active
        bool is_superuser
        datetime created_at
    }
    roles {
        int id PK
        string name UK
        string description
        bool is_active
    }
    revoked_tokens {
        int id PK
        string jti UK
        datetime revoked_at
    }

