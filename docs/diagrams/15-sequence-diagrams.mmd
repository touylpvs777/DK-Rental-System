%% ============================================================================
%% SEQUENCE 4: Work Order → Part Consumption → Service History
%% ============================================================================

sequenceDiagram
    autonumber
    participant U as Technician
    participant SPA as React SPA
    participant MR as /maintenance
    participant MS as MaintenanceService
    participant IS as InventoryService
    participant DB as Database

    U->>SPA: Create work order
    SPA->>MR: POST /work-orders {forklift_id, type, title, scheduled_date}
    MR->>MS: create_work_order(data, user)
    MS->>DB: INSERT work_order (status=scheduled)
    MS-->>SPA: WorkOrderOut

    U->>SPA: Start work
    SPA->>MR: POST /work-orders/:id/start
    MR->>MS: start(id, user)
    MS->>DB: UPDATE status = in_progress, started_at = now
    MS-->>SPA: 200 OK

    U->>SPA: Consume spare part
    SPA->>MR: POST /work-orders/:id/consume {part_id, quantity}
    MR->>MS: consume_part(wo_id, data)
    MS->>IS: deduct_stock(part_id, warehouse_id, qty)
    IS->>DB: INSERT inventory_transaction (type=issue)
    IS->>DB: UPDATE inventory_balance (qty -= consumed)
    MS->>DB: INSERT part_consumption
    MS-->>SPA: ConsumptionOut

    U->>SPA: Log maintenance cost
    SPA->>MR: POST /work-orders/:id/costs {type: labor, amount, description}
    MR->>MS: add_cost(wo_id, data)
    MS->>DB: INSERT maintenance_cost
    MS-->>SPA: CostOut

    U->>SPA: Complete work order
    SPA->>MR: POST /work-orders/:id/complete {findings, resolution, actual_hours}
    MR->>MS: complete(id, data, user)
    MS->>DB: UPDATE status = completed, completed_at = now
    MS->>DB: INSERT service_history
    MS->>DB: UPDATE forklift current_hour_meter
    MS-->>SPA: 200 OK

    U->>SPA: Verify (supervisor)
    SPA->>MR: POST /work-orders/:id/verify
    MR->>MS: verify(id, user)
    MS->>DB: UPDATE status = verified, verified_at = now
    MS->>DB: UPDATE maintenance_schedule next_due_date
    MS-->>SPA: 200 OK
